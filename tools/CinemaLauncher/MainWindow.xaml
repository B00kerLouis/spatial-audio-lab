<Window x:Class="SpatialAudioLab.Cinema.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SpatialAudioLab Cinema · 影院" Width="980" Height="680" MinWidth="780" MinHeight="540" WindowStartupLocation="CenterScreen" FontFamily="Microsoft YaHei UI" FontSize="14" Background="#F3F5F6">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="空间音频影院" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="7.1.4 · Dante ASIO · 每次启动自动加载 default.ini" Margin="0,6,0,16" Foreground="#506070"/></StackPanel>
    <DockPanel Grid.Row="1" Margin="0,0,0,14"><Button Content="打开影片…" Click="OpenClick" Padding="16,8" DockPanel.Dock="Right" Margin="10,0,0,0"/><TextBox x:Name="MediaPathText" IsReadOnly="True" VerticalContentAlignment="Center" Text="请选择 MKV / MKA 影片"/></DockPanel>
    <WrapPanel Grid.Row="2" Margin="0,0,0,14"><Button x:Name="PlayButton" Content="播放" Click="PlayClick" Padding="28,8" IsEnabled="False"/><Button x:Name="StopButton" Content="停止" Click="StopClick" Padding="28,8" Margin="10,0" IsEnabled="False"/><Button Content="打开 Studio" Click="StudioClick" Padding="16,8"/><Button Content="打开日志目录" Click="LogsClick" Padding="16,8" Margin="10,0"/><Button Content="检查 Dante ASIO" Click="CheckDanteClick" Padding="16,8"/></WrapPanel>
    <StackPanel Grid.Row="3" Margin="0,0,0,14"><WrapPanel Margin="0,0,0,10"><TextBlock Text="播放音量" VerticalAlignment="Center"/><Slider x:Name="GainSlider" Minimum="0" Maximum="1" Value="1" Width="160" Margin="10,0,20,0"/><TextBlock Text="影音延迟（ms）" VerticalAlignment="Center"/><TextBox x:Name="AvDelayText" Text="0" Width="80" Margin="10,0,0,0"/></WrapPanel><TextBlock x:Name="ProfileText" TextWrapping="Wrap"/><TextBlock Text="输出顺序：L、R、C、LF、LS、RS、LSR、RSR、LTF、RTF、LTR、RTR → ASIO 1–12" TextWrapping="Wrap" Margin="0,6,0,0"/><TextBlock Text="影片直接输出至原生音频引擎；无需先开启 Studio 实时桥接。" Foreground="#506070" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
    <TextBox Grid.Row="4" x:Name="LogText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas,Microsoft YaHei UI" Background="White"/>
    <TextBlock Grid.Row="5" x:Name="StatusText" Text="就绪" Margin="0,14,0,0" TextWrapping="Wrap"/>
  </Grid>
</Window>
