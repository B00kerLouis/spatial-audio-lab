<Window x:Class="SpeakerLayoutEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpatialAudioLab Studio · 空间音频工作室" Width="1440" Height="760"
        WindowStartupLocation="CenterScreen"
        MinWidth="1180" MinHeight="640" Background="#F3F5F6"
        FontFamily="Microsoft YaHei UI" FontSize="13">
  <Window.Resources>
    <Style x:Key="IconButton" TargetType="Button">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#4B535A" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
      <Setter Property="FontSize" Value="16" />
    </Style>
    <Style x:Key="SegmentButton" TargetType="RadioButton">
      <Setter Property="Height" Value="34" />
      <Setter Property="Foreground" Value="#252A2E" />
      <Setter Property="Background" Value="#E7EBED" />
      <Setter Property="BorderBrush" Value="#B8C0C5" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="SegmentBorder" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="SegmentBorder" Property="Background" Value="#D8DEE2" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="SegmentBorder" Property="Background" Value="#3478A5" />
                <Setter TargetName="SegmentBorder" Property="BorderBrush" Value="#286589" />
                <Setter Property="Foreground" Value="White" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="SegmentBorder" Property="Opacity" Value="0.65" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Slider">
      <Setter Property="Margin" Value="0,4,0,12" />
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#252A2E" />
    </Style>
  </Window.Resources>

  <DockPanel>
    <Border DockPanel.Dock="Top" Height="54" Background="#252B30"
            BorderBrush="#161A1D" BorderThickness="0,0,0,1">
      <Grid Margin="12,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button Grid.Column="0" Style="{StaticResource IconButton}" Content="&#xE8E5;"
                ToolTip="打开配置" Click="OpenClick" />
        <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE74E;"
                ToolTip="保存配置" Click="SaveClick" />
        <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE792;"
                ToolTip="另存为" Click="SaveAsClick" />
        <TextBlock Grid.Column="4" x:Name="PathText" Foreground="#DCE1E4"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="5" Text="7.1.4" Foreground="#9FD4B2" FontWeight="SemiBold"
                   VerticalAlignment="Center" FontSize="15" />
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom" Height="30" Background="#E2E6E8"
            BorderBrush="#C7CDD1" BorderThickness="0,1,0,0">
      <TextBlock x:Name="StatusText" Margin="12,0" VerticalAlignment="Center"
                 Text="就绪" />
    </Border>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="210" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="500" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="#E9EDEF" BorderBrush="#C9CFD3"
              BorderThickness="0,0,1,0">
        <DockPanel Margin="12">
          <TextBlock DockPanel.Dock="Top" Text="扬声器" FontSize="11"
                     Foreground="#596168" FontWeight="SemiBold" Margin="4,4,0,8" />
          <ListBox x:Name="SpeakerList" BorderThickness="0" Background="Transparent"
                   SelectionChanged="SpeakerSelectionChanged"
                   DisplayMemberPath="DisplayName" />
        </DockPanel>
      </Border>

      <Grid Grid.Column="1" Margin="18,14">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="190" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="4,0,4,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="LayoutNameText" FontSize="20" FontWeight="SemiBold"
                     VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" x:Name="RouteLegend" Orientation="Horizontal"
                      VerticalAlignment="Center" />
        </Grid>
        <Border Grid.Row="1" Background="White" BorderBrush="#C9CFD3" BorderThickness="1">
          <Canvas x:Name="TopCanvas" ClipToBounds="True"
                  SizeChanged="CanvasSizeChanged"
                  MouseMove="CanvasMouseMove"
                  MouseLeftButtonUp="CanvasMouseUp" />
        </Border>
        <Grid Grid.Row="2" Margin="0,14,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Text="仰角" FontSize="11" Foreground="#596168"
                     FontWeight="SemiBold" Margin="4,0,0,6" />
          <Border Grid.Row="1" Background="White" BorderBrush="#C9CFD3" BorderThickness="1">
            <Canvas x:Name="ElevationCanvas" ClipToBounds="True"
                    SizeChanged="CanvasSizeChanged"
                    MouseMove="CanvasMouseMove"
                    MouseLeftButtonUp="CanvasMouseUp" />
          </Border>
        </Grid>
      </Grid>

      <Border Grid.Column="2" Background="#FAFBFB" BorderBrush="#C9CFD3"
              BorderThickness="1,0,0,0">
        <TabControl Background="Transparent" BorderThickness="0" Margin="12">
          <TabItem Header="扬声器">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="6,16,6,6">
                <TextBlock x:Name="SelectedNameText" FontSize="18" FontWeight="SemiBold"
                           Margin="0,0,0,18" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="70" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="方位角" />
                  <TextBlock Grid.Column="1" x:Name="AzimuthValue" TextAlignment="Right" />
                </Grid>
                <Slider x:Name="AzimuthSlider" Minimum="-180" Maximum="180"
                        ValueChanged="SpeakerControlChanged" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="70" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="仰角" />
                  <TextBlock Grid.Column="1" x:Name="ElevationValue" TextAlignment="Right" />
                </Grid>
                <Slider x:Name="ElevationSlider" Minimum="-30" Maximum="90"
                        ValueChanged="SpeakerControlChanged" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="70" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="电平" />
                  <TextBlock Grid.Column="1" x:Name="TrimValue" TextAlignment="Right" />
                </Grid>
                <Slider x:Name="TrimSlider" Minimum="-24" Maximum="12"
                        ValueChanged="SpeakerControlChanged" />
                <TextBlock Text="物理输出" Margin="0,4,0,6" />
                <ComboBox x:Name="PhysicalDestinationCombo" DisplayMemberPath="DisplayName"
                          SelectionChanged="PhysicalDestinationSelectionChanged" Height="30"
                          ToolTip="此扬声器对应的设备与物理声道" />
                <TextBlock x:Name="DestinationEndpointText" Margin="2,5,2,0"
                           Foreground="#596168" TextWrapping="Wrap"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                <Button Height="36" Margin="0,14,0,0" Click="ResetPositionsClick"
                        ToolTip="恢复全部扬声器的默认方位角与仰角">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE777;"
                               FontSize="15" Margin="0,0,8,0" />
                    <TextBlock Text="恢复默认位置" />
                  </StackPanel>
                </Button>
                <TextBlock Text="测音增益" Margin="0,14,0,2" />
                <Slider x:Name="TestGainSlider" Minimum="0" Maximum="0.25" Value="0.08" />
                <Button Height="38" Margin="0,10,0,0" Click="TestSpeakerClick"
                        HorizontalContentAlignment="Center">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE768;"
                               FontSize="16" Margin="0,0,8,0" />
                    <TextBlock Text="测试扬声器" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="输出">
            <Grid Margin="4,12,4,4">
              <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="可用音频设备" FontSize="11" Foreground="#596168"
                           FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Grid.Column="1" x:Name="RefreshEndpointsButton" Width="30" Height="28"
                        FontFamily="Segoe Fluent Icons" FontSize="14" Content="&#xE72C;"
                        ToolTip="刷新设备" Click="RefreshEndpointsClick" />
              </Grid>
              <DataGrid Grid.Row="1" x:Name="OutputGrid" AutoGenerateColumns="False"
                        CanUserAddRows="False" CanUserDeleteRows="False"
                        HeadersVisibility="Column" RowHeaderWidth="0" RowHeight="38"
                        ColumnHeaderHeight="30" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="路由" Binding="{Binding Name}" IsReadOnly="True"
                                      Width="78" />
                  <DataGridTemplateColumn Header="设备" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <ComboBox ItemsSource="{Binding EndpointChoices,
                                    RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                  DisplayMemberPath="DisplayName" SelectedValuePath="Filter"
                                  SelectedValue="{Binding Endpoint, Mode=OneWay}"
                                  SelectionChanged="EndpointSelectionChanged"
                                  ToolTip="{Binding Endpoint}" Height="28"
                                  VerticalAlignment="Center" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="ms" Binding="{Binding DelayMilliseconds}"
                                      Width="48" />
                  <DataGridTemplateColumn Header="声道映射" Width="118" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding ChannelMapText}" ToolTip="{Binding ChannelMapText}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
              <StackPanel Grid.Row="2" Margin="0,12,0,0">
                <TextBlock Text="ASIO（全部扬声器使用同一设备）" FontWeight="SemiBold" />
                <DockPanel Margin="0,6,0,0">
                  <Button DockPanel.Dock="Right" Content="刷新 ASIO" Click="RefreshAsioClick" Margin="6,0,0,0" />
                  <ComboBox x:Name="AsioDriverCombo" DisplayMemberPath="Name" MinWidth="140" />
                </DockPanel>
                <TextBlock Text="物理声道（从 1 开始，以逗号分隔）" Margin="0,6,0,2" />
                <TextBox x:Name="AsioChannelsText" ToolTip="留空则使用连续声道 1..N" />
                <DockPanel Margin="0,6,0,0">
                  <Button DockPanel.Dock="Right" x:Name="ApplyAsioButton" Content="应用 ASIO" Click="ApplyAsioClick" Margin="6,0,0,0" />
                  <TextBlock Text="缓冲帧数（0＝驱动首选）：" VerticalAlignment="Center" />
                  <TextBox x:Name="AsioBufferText" Text="0" MinWidth="50" />
                </DockPanel>
                <TextBlock x:Name="AsioStatusText" Text="刷新以查找已安装的 64 位 ASIO 驱动。" TextWrapping="Wrap" Margin="0,6,0,0" />
              </StackPanel>
            </Grid>
          </TabItem>
          <TabItem Header="实时桥接">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="8,18,8,8">
                <TextBlock Text="Windows 捕获端点（选择 HISENSE 虚拟声卡）" TextWrapping="Wrap" />
                <DockPanel Margin="0,6,0,4">
                  <Button DockPanel.Dock="Right" Content="刷新" Click="RefreshEndpointsClick" Margin="6,0,0,0" />
                  <ComboBox x:Name="VirtualEndpointCombo" DisplayMemberPath="Name" SelectionChanged="VirtualEndpointSelectionChanged" MinWidth="100" />
                </DockPanel>
                <TextBlock x:Name="VirtualEndpointStatus" Text="自动识别 HISENSE 虚拟端点；手动选择后会保存。" TextWrapping="Wrap" Margin="0,0,0,16" />
                <Grid Margin="0,0,0,18">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="34" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="34" />
                  </Grid.RowDefinitions>
                  <RadioButton x:Name="MatModeButton" Style="{StaticResource SegmentButton}"
                               GroupName="BridgeMode" IsChecked="True" Content="杜比全景声（Windows）"
                               Click="BridgeModeClick"
                               ToolTip="通过 Windows 空间音效接收杜比全景声" />
                  <RadioButton Grid.Column="2" x:Name="DtsXModeButton"
                               Style="{StaticResource SegmentButton}" GroupName="BridgeMode"
                               Content="DTS:X" Click="BridgeModeClick" />
                  <RadioButton Grid.Row="2" x:Name="NativeMatModeButton"
                               Style="{StaticResource SegmentButton}" GroupName="BridgeMode"
                               Content="原生 MAT（BF1）" Click="BridgeModeClick"
                               ToolTip="关闭 Windows 空间音效，直接接收 MAT 载波" />
                  <RadioButton Grid.Row="2" Grid.Column="2" x:Name="PcmModeButton"
                               Style="{StaticResource SegmentButton}" GroupName="BridgeMode"
                               Content="PCM 7.1.4" Click="BridgeModeClick"
                               ToolTip="原生 PCM 渲染，无需 Dolby / DTS 编码器" />
                </Grid>

                <Grid Margin="0,0,0,22">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Ellipse x:Name="BridgeStatusDot" Width="10" Height="10"
                           Fill="#8B949A" HorizontalAlignment="Left"
                           VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" x:Name="BridgeStatusText" Text="正在检查…"
                             FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                </Grid>

                <TextBlock Text="延迟模式" FontSize="11" FontWeight="SemiBold"
                           Foreground="#59636A" Margin="0,0,0,8" />
                <Grid Margin="0,0,0,18">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <RadioButton x:Name="SafeLatencyButton" Style="{StaticResource SegmentButton}"
                               GroupName="BridgeLatency" Content="稳妥"
                               ToolTip="默认周期，80 ms 预缓冲"
                               Checked="BridgeLatencyChecked" />
                  <RadioButton Grid.Column="2" x:Name="BalancedLatencyButton"
                               Style="{StaticResource SegmentButton}" GroupName="BridgeLatency"
                               Content="均衡" IsChecked="True"
                               ToolTip="中等周期，40 ms 预缓冲"
                               Checked="BridgeLatencyChecked" />
                  <RadioButton Grid.Column="4" x:Name="LowLatencyButton"
                               Style="{StaticResource SegmentButton}" GroupName="BridgeLatency"
                               Content="低延迟" ToolTip="最短周期，20 ms 预缓冲"
                               Checked="BridgeLatencyChecked" />
                </Grid>

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="增益" />
                  <TextBlock Grid.Column="1" x:Name="BridgeGainValue" TextAlignment="Right" />
                </Grid>
                <Slider x:Name="BridgeGainSlider" Minimum="0" Maximum="1" Value="0.25"
                        TickFrequency="0.01" ValueChanged="BridgeControlChanged" />

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="预缓冲" />
                  <TextBlock Grid.Column="1" x:Name="BridgePrebufferValue" TextAlignment="Right" />
                </Grid>
                <Slider x:Name="BridgePrebufferSlider" Minimum="20" Maximum="500" Value="40"
                        TickFrequency="10" IsSnapToTickEnabled="True"
                        ValueChanged="BridgeControlChanged" />

                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Button x:Name="BridgeStartButton" Height="42" Click="StartBridgeClick">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE768;"
                                 FontSize="16" Margin="0,0,8,0" />
                      <TextBlock x:Name="BridgeStartText" Text="启动" />
                    </StackPanel>
                  </Button>
                  <Button Grid.Column="2" x:Name="BridgeStopButton" Height="42"
                          Click="StopBridgeClick" IsEnabled="False">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE71A;"
                                 FontSize="16" Margin="0,0,8,0" />
                      <TextBlock Text="停止" />
                    </StackPanel>
                  </Button>
                </Grid>

                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Button Height="36" Click="OpenSpatialSettingsClick">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE713;"
                                 FontSize="15" Margin="0,0,8,0" />
                      <TextBlock Text="Windows 空间音效" />
                    </StackPanel>
                  </Button>
                  <Button Grid.Column="2" x:Name="BridgeOpenLogButton" Height="36"
                          Click="OpenBridgeLogClick">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8A5;"
                                 FontSize="15" Margin="0,0,8,0" />
                      <TextBlock Text="打开日志" />
                    </StackPanel>
                  </Button>
                </Grid>

                <WrapPanel Margin="0,10,0,8">
                  <Button Content="打开 Dolby Access" Tag="Dolby" Click="OpenSpatialAppClick" Padding="8,5" Margin="0,0,6,0" />
                  <Button Content="打开 DTS Sound Unbound" Tag="DtsX" Click="OpenSpatialAppClick" Padding="8,5" />
                </WrapPanel>
                <Button Content="检查并重新注册 Dolby / DTS 应用" Click="SpatialDiagnosticsClick" Padding="8,6" Margin="0,0,0,10" />
                <TextBlock Text="实时游戏桥接需安装虚拟驱动并启用对应空间音效。Cinema 影片可直接输出 ASIO。" TextWrapping="Wrap" Margin="0,0,0,10" />
                <TextBlock Text="声道电平" FontSize="11" FontWeight="SemiBold"
                           Foreground="#59636A" Margin="0,18,0,8" />
                <UniformGrid x:Name="BridgeMeterPanel" Columns="2" />
              </StackPanel>
            </ScrollViewer>
          </TabItem>
        </TabControl>
      </Border>
    </Grid>
  </DockPanel>
</Window>
